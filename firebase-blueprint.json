{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store catalog item including fashion and footwear",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string" },
        "subCategory": { "type": "string" },
        "images": { "type": "array" },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "stock": { "type": "number" },
        "isNew": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" }
      },
      "required": ["id", "name", "price", "category", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "city": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "items": { "type": "array" }
      },
      "required": ["id", "orderNumber", "customerName", "customerPhone", "total", "status", "createdAt"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store configuration, shipping options, driver tracking and coupons",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "shippingCost": { "type": "number" },
        "coupons": { "type": "array" },
        "brands": { "type": "array" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of catalog products for the store"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders submitted from checkout"
    },
    "/store_settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Store general settings, driver tracking, and coupons"
    }
  }
}
